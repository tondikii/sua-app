    {
      "name": "Auth",
      "description": "Google Sign-In and username onboarding (M3).",
      "item": [
        {
          "name": "Google Sign-In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.access_token);",
                  "        pm.environment.set('access_token', body.access_token);",
                  "    }",
                  "    if (body.realtime_token) {",
                  "        pm.collectionVariables.set('realtime_token', body.realtime_token);",
                  "        pm.environment.set('realtime_token', body.realtime_token);",
                  "    }",
                  "    if (body.user && body.user.username) {",
                  "        pm.collectionVariables.set('username', body.user.username);",
                  "        pm.environment.set('username', body.user.username);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response has access_token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('access_token');",
                  "    pm.expect(body).to.have.property('is_new_user');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Verify Google ID token and sign in / register user.\n\n**Auth:** None (public)\n\n**Body:**\n- `id_token` (string, required) — Google OAuth ID token\n\n**Response:**\n```json\n{\n  \"access_token\": \"...\",\n  \"realtime_token\": \"...\",\n  \"is_new_user\": false,\n  \"user\": { \"id\": \"...\", \"name\": \"...\", \"username\": \"...\", ... }\n}\n```\n\n`user` is omitted when `is_new_user` is `true` — call **Complete Registration** next.\n\n**Errors:** `401` invalid Google token"
          },
          "response": []
        },
        {
          "name": "Complete Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.user && body.user.username) {",
                  "        pm.collectionVariables.set('username', body.user.username);",
                  "        pm.environment.set('username', body.user.username);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response has user profile', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('user');",
                  "    pm.expect(body.user).to.have.property('username');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/complete-registration",
              "host": ["{{base_url}}"],
              "path": ["auth", "complete-registration"]
            },
            "description": "Set username for a newly registered user.\n\n**Auth:** Bearer JWT (required)\n\n**Body:**\n- `username` (string, required) — 3–30 chars, `[a-zA-Z0-9_]+`\n\n**Response:**\n```json\n{ \"user\": { \"id\": \"...\", \"username\": \"...\", ... } }\n```\n\n**Errors:** `409 USERNAME_TAKEN`, `400 USERNAME_INVALID`"
          },
          "response": []
        },
        {
          "name": "Google Sign-In (User 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.access_token) {",
                  "        pm.collectionVariables.set('access_token_2', body.access_token);",
                  "        pm.environment.set('access_token_2', body.access_token);",
                  "    }",
                  "    if (body.realtime_token) {",
                  "        pm.collectionVariables.set('realtime_token_2', body.realtime_token);",
                  "        pm.environment.set('realtime_token_2', body.realtime_token);",
                  "    }",
                  "    if (body.user && body.user.username) {",
                  "        pm.collectionVariables.set('username_2', body.user.username);",
                  "        pm.environment.set('username_2', body.user.username);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response has access_token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('access_token');",
                  "    pm.expect(body).to.have.property('is_new_user');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token_2}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Sign in the **second** test user. Saves the returned JWT to `access_token_2` (and `realtime_token_2`) so you can act as two users at once without re-logging in.\n\nSet `google_id_token_2` in the environment to User 2's Google ID token before running.\n\nUse `{{access_token_2}}` as the Bearer token in any request you want to send *as User 2* (several ready-made variants are included in the Invitations and Voting folders)."
          },
          "response": []
        },
        {
          "name": "Complete Registration (User 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.user && body.user.username) {",
                  "        pm.collectionVariables.set('username_2', body.user.username);",
                  "        pm.environment.set('username_2', body.user.username);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Status is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token_2}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username_2}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/complete-registration",
              "host": ["{{base_url}}"],
              "path": ["auth", "complete-registration"]
            },
            "description": "Set the username for the **second** newly-registered user. Authenticated as User 2 (`{{access_token_2}}`)."
          },
          "response": []
        }
      ]
    },
