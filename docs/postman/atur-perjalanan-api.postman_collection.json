              "raw": "{{base_url}}/trips/{{trip_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}"]
            },
            "description": "Soft-delete a trip. Creator only. Returns 204 No Content."
          },
          "response": []
        },
        {
          "name": "Set Trip Cover",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{document_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/cover",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "cover"]
            },
            "description": "Set or update trip cover image. Creator only. Document must exist in this trip."
          },
          "response": []
        },
        {
          "name": "Get Trip Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "members"]
            },
            "description": "Members screen payload (WORKFLOW §11). Returns `{ is_creator, members[], invitations[] }`.\n\n- `members[]`: active participants — `{ id, name, username, avatar_url, joined_at, role: creator|member }`\n- `invitations[]`: outstanding invites (pending + declined) — `{ id, method, status, state, invited_user, invited_email, invited_by, created_at }` where `state` is `email_sent` | `pending_accept` | `rejected`. Use `state=rejected` rows for the \"Undang kembali\" action; use `invited_user`/`invited_email` to mark already-invited rows in search results.\n\nAny member may view. `is_creator` gates the \"Keluarkan\" button."
          },
          "response": []
        },
        {
          "name": "Remove Trip Member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/members/{{member_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "members", "{{member_id}}"]
            },
            "description": "Remove a member from trip. Creator only. Returns 204 No Content."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Invitations",
      "description": "Trip invitation management — invite users, respond to invitations, cancel pending invites (M4).",
      "item": [
        {
          "name": "Get My Invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/invitations?limit=20",
              "host": ["{{base_url}}"],
              "path": ["trips", "invitations"],
              "query": [
                {"key": "cursor", "value": "", "description": "UUID for pagination", "disabled": true},
                {"key": "limit", "value": "20", "description": "Default 20, max 100"}
              ]
            },
            "description": "List pending invitations for the current user, enriched with trip and inviter summaries."
          },
          "response": []
        },
        {
          "name": "Invite User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('invitation_id', body.id);",
                  "    pm.environment.set('invitation_id', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user2_travel\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/invitations",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "invitations"]
            },
            "description": "Invite a user to a trip via username or email. Only trip participants can invite. Provide exactly one of: `username` or `email`.\n\nAlso serves as **re-invite (\"Undang kembali\")**: if the target has a `declined`/`cancelled` invitation, it is reactivated to `pending` (no duplicate row). Returns `409 INVITATION_EXISTS` only if a `pending` invite already exists, `409 ALREADY_PARTICIPANT` if already a member."
          },
          "response": []
        },
        {
          "name": "Accept Invitation",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/invitations/{{invitation_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "invitations", "{{invitation_id}}"]
            },
            "description": "Accept or decline a trip invitation. Set accept to true/false. Returns 204 No Content."
          },
          "response": []
        },
        {
          "name": "Cancel Invitation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/invitations/{{invitation_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "invitations", "{{invitation_id}}"]
            },
            "description": "Cancel a pending invitation. Inviter only. Returns 204 No Content."
          },
          "response": []
        },
        {
          "name": "Get My Invitations (User 2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {"key": "token", "value": "{{access_token_2}}", "type": "string"}
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/invitations?limit=20",
              "host": ["{{base_url}}"],
              "path": ["trips", "invitations"],
              "query": [
                {"key": "cursor", "value": "", "description": "UUID for pagination", "disabled": true},
                {"key": "limit", "value": "20", "description": "Default 20, max 100"}
              ]
            },
            "description": "List pending invitations **for User 2** (`{{access_token_2}}`). Run this after User 1 invites User 2 to grab the `invitation_id` to accept.\n\nTip: add a test script to auto-save `invitation_id` from `data[0].id` if you like."
          },
          "response": []
        },
        {
          "name": "Accept Invitation (User 2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {"key": "token", "value": "{{access_token_2}}", "type": "string"}
              ]
            },
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accept\": true\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/invitations/{{invitation_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "invitations", "{{invitation_id}}"]
            },
            "description": "Accept (or decline) the invitation **as User 2** (`{{access_token_2}}`) — no login switch needed. Set `accept` to true/false. Returns 204 No Content.\n\nTypical flow: **Invite User** (as User 1) → **Get My Invitations (User 2)** → **Accept Invitation (User 2)**."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Voting",
      "description": "Multi-poll voting for trip dates, activities, and other options (M5).",
      "item": [
        {
          "name": "List Polls",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls"]
            },
            "description": "List all polls for a trip with vote tallies and current user vote.\n\n**Response 200:**\n```json\n{\n  \"data\": [\n    {\n      \"id\": \"poll-1\",\n      \"poll_type\": \"aktivitas\",\n      \"title\": \"Best Activity\",\n      \"status\": \"active\",\n      \"deadline\": null,\n      \"locked_at\": null,\n      \"creator\": { \"id\": \"user-1\", \"name\": \"Alice\", \"username\": \"alice\", \"avatar_url\": null },\n      \"options\": [\n        { \"id\": \"opt-1\", \"label\": \"Hiking\", \"sort_order\": 0, \"candidate_id\": null, \"vote_count\": 2 },\n        { \"id\": \"opt-2\", \"label\": \"Swimming\", \"sort_order\": 1, \"candidate_id\": null, \"vote_count\": 1 }\n      ],\n      \"voted_option_id\": \"opt-1\",\n      \"created_at\": \"2026-07-12T12:00:00.000Z\"\n    }\n  ],\n  \"next_cursor\": null\n}\n```"
          },
          "response": []
        },
        {
          "name": "Create Poll",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Best Activity\",\n  \"poll_type\": \"aktivitas\",\n  \"options\": [\"Hiking\", \"Swimming\"],\n  \"deadline\": null\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls"]
            },
            "description": "Create a new poll (aktivitas or lainnya). Tanggal polls are auto-created when trip enters voting_pending. Creator only.\n\n**Request body:**\n- `title` (string): Poll title\n- `poll_type` ('aktivitas' | 'lainnya'): Poll type\n- `options` (string[]): 2–10 option labels\n- `deadline` (ISO 8601 string, optional): Vote deadline\n\n**Response 201:** Poll object with empty vote counts.\n\n**Errors:**\n- 400: Fewer than 2 options, tanggal poll creation attempt, > 10 options\n- 409: Active poll already exists for this poll_type"
          },
          "response": []
        },
        {
          "name": "Vote on Poll",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": \"{{option_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}", "vote"]
            },
            "description": "Vote on a poll option. Replaces previous vote if voter already voted. No-op if voting for same option. Set `poll_id` and `option_id` (real UUIDs from **List Polls**) in the environment first.\n\n**Response 204:** No Content."
          },
          "response": []
        },
        {
          "name": "Retract Poll Vote",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}", "vote"]
            },
            "description": "Retract the current user's vote on a poll.\n\n**Response 204:** No Content."
          },
          "response": []
        },
        {
          "name": "Vote on Date Candidate",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidate_id\": \"{{candidate_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/candidates/{{candidate_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "candidates", "{{candidate_id}}", "vote"]
            },
            "description": "Vote on a date candidate. Separate from generic polls (tanggal poll voting). Set `candidate_id` (real UUID) in the environment first.\n\n**Response 204:** No Content."
          },
          "response": []
        },
        {
          "name": "Retract Date Candidate Vote",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/candidates/{{candidate_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "candidates", "{{candidate_id}}", "vote"]
            },
            "description": "Retract the current user's vote on a date candidate.\n\n**Response 204:** No Content."
          },
          "response": []
        },
        {
          "name": "Lock Poll",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}/lock",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}", "lock"]
            },
            "description": "Lock a poll (creator only). If tanggal poll, updates trip dates to winning candidate and sets trip status to 'fixed'.\n\n**Response 204:** No Content.\n\n**Errors:**\n- 403: Not the trip creator"
          },
          "response": []
        },
        {
          "name": "Delete Poll",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}"]
            },
            "description": "Delete an active poll (creator only). Response 204: No Content. Errors: 400 Poll not active, 403 Not the trip creator"
          },
          "response": []
        },
        {
          "name": "Vote on Poll (User 2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {"key": "token", "value": "{{access_token_2}}", "type": "string"}
              ]
            },
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": \"{{option_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}", "vote"]
            },
            "description": "Cast a vote **as User 2** (`{{access_token_2}}`) — lets you build up a real tally with two voters without switching login. User 2 must be a participant of the trip (accept the invitation first). Set `poll_id` and `option_id` from **List Polls**.\n\n**Response 204:** No Content."
          },
          "response": []
        },
        {
          "name": "Retract Vote (User 2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {"key": "token", "value": "{{access_token_2}}", "type": "string"}
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/polls/{{poll_id}}/vote",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "polls", "{{poll_id}}", "vote"]
            },
            "description": "Retract User 2's vote on a poll (`{{access_token_2}}`).\n\n**Response 204:** No Content."
          },
          "response": []
        }
      ]
    },
