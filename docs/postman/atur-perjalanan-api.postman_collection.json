              "raw": "{{base_url}}/notifications/:id/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", ":id", "read"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{notification_id}}",
                  "description": "Notification UUID"
                }
              ]
            },
            "description": "Mark a single notification as read. User can only mark their own notifications.\n\n**URL params:**\n- `id`: Notification UUID\n\n**Response 204:** No content (notification marked as read)\n\n**Response 404:** Notification not found\n\n**Response 403:** Access denied (notification belongs to another user)"
          },
          "response": []
        },
        {
          "name": "Mark All as Read",
