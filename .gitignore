# ============================================================
#  Atur Perjalanan — .gitignore
# ============================================================

# Environment files — NEVER commit these
.env
.env.local
.env.*.local
.env.old

# Dependencies
node_modules/
figma/node_modules/

# Build outputs
dist/
build/
.expo/

# Vercel function bundle (generated by backend build:function)
api/index.js
api/*.js.map

# Turbo
.turbo/

# Prisma
backend/prisma/generated/

# Test artifacts
coverage/
*.lcov

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# EAS
*.ipa
*.apk
*.aab