# ============================================================
#  Atur Perjalanan — Environment Variables Template
#  Copy this to .env (root) and backend/.env, then fill values.
#  NEVER commit the actual .env files.
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Connection pooler endpoint (PgBouncer port 6543) — used by NestJS at runtime
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Direct connection (port 5432) — used only by `prisma migrate`
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── App Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-random-256-bit-secret

# ── Google ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Google Maps Platform API key — Places/Static Maps for activity thumbnails (M6)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Google Calendar OAuth 2.0 client (M16) — create events in the user's own
# calendar via per-user OAuth (scope: https://www.googleapis.com/auth/calendar.events).
# Buat OAuth client di Google Cloud Console → Credentials → OAuth 2.0 Client IDs,
# lalu daftarkan redirect URI: http://localhost:8080/v1/integrations/google-calendar/callback
# (dan URL production). Wajib akses offline (refresh token) + prompt consent.
GOOGLE_CALENDAR_CLIENT_ID=your-calendar-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-oauth-client-secret

# ── Cloudflare R2 ────────────────────────────────────────────
# Wajib — dipakai R2Service untuk presign upload (PUT) & download (GET)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-access-key
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
R2_BUCKET_NAME=atur-perjalanan-media

# ── Cloudflare R2: CORS (web uploads) ────────────────────────
# Agar upload langsung ke R2 dari browser (web) tidak kena CORS preflight,
# bucket R2 harus punya aturan CORS yang mengizinkan origin app kamu:
#   - Allowed origins: http://localhost:8081 (dev web) + domain production
#   - Allowed methods: PUT, GET, HEAD
#   - Allowed headers: Content-Type, Content-Length, x-amz-*
#   - Expose headers: ETag, x-amz-checksum-*, x-amz-request-id
# Konfigurasi lewat Dashboard Cloudflare R2 → bucket → Settings → CORS
# (JSON):
# [
#   {
#     "AllowedOrigins": ["http://localhost:8081", "https://app.aturperjalanan.id"],
#     "AllowedMethods": ["PUT", "GET", "HEAD"],
#     "AllowedHeaders": ["Content-Type", "Content-Length", "x-amz-*"],
#     "ExposeHeaders": ["ETag", "x-amz-checksum-*", "x-amz-request-id"],
#     "MaxAgeSeconds": 3600
#   }
# ]

# Opsional — referensi internal saat menyimpan storage_url di DB.
# Client TIDAK memakai URL ini; akses media ke frontend via presigned GET
# (expires 1 jam) yang di-generate backend pada Register/List Documents,
# trip cover, chat media, dll. Lihat docs/ARCHITECTURE.md §7.
R2_PUBLIC_URL=https://your-r2-custom-domain.example.com

# ── Server ───────────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── Email (SMTP) ─────────────────────────────────────────────
# Dipakai MailService untuk mengirim undangan via email (trip invitation).
# Jika SMTP_HOST kosong, email undangan tidak dikirim dan UI menampilkan
# status jujur (undangan tetap tersimpan sebagai pending di database).
SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Atur Perjalanan <noreply@atur-perjalanan.app>
# Base URL aplikasi web — dipakai untuk link undangan di email
APP_WEB_URL=http://localhost:8081

# ── Expo Push Notifications ──────────────────────────────────
# Token akses dari https://expo.dev/settings/access-tokens untuk mengirim
# push notification via Expo Push Service. Kosongkan di development →
# backend tetap membuat notifikasi in-app tapi push di-skip (no-op).
EXPO_ACCESS_TOKEN=your-expo-access-token

# ── Mobile (Expo) ────────────────────────────────────────────
# These are prefixed EXPO_PUBLIC_ so Metro inlines them at build time.
# Google OAuth 2.0 client IDs — required for sign-in flow
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Backend API URL — used by apiClient for all REST calls
EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# Supabase anon key & URL — used by realtime/supabaseClient (Realtime subscriptions only)
EXPO_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web dev origin (OAuth redirect target on web)
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8081