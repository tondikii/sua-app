# ============================================================
#  Atur Perjalanan — Environment Variable Template
# ============================================================
#
#  HOW TO SET UP (two separate .env files are required):
#
#  Step 1 — Root .env  (for Docker Compose)
#    Copy this file to the ROOT of the repo as `.env`
#    Docker Compose reads it automatically.
#
#  Step 2 — backend/.env  (for the Go server)
#    Copy this file to `backend/.env`
#    The Go server loads it via godotenv on startup.
#
#  NEVER commit either .env file. Both are in .gitignore.
# ============================================================


# ── PostgreSQL (Docker Compose) ─────────────────────────────
POSTGRES_USER=aturperjalanan
POSTGRES_PASSWORD=secret
POSTGRES_DB=aturperjalanan_dev
# Host port for Docker Postgres. Use 5433 so it never clashes with a local
# PostgreSQL server that often occupies 5432 (Homebrew, Postgres.app, DBeaver host, etc.)
DB_HOST_PORT=5433


# ── Backend Server ──────────────────────────────────────────
# Port in DATABASE_URL must match DB_HOST_PORT above.
DATABASE_URL=postgres://aturperjalanan:secret@localhost:5433/aturperjalanan_dev?sslmode=disable
PORT=8080
APP_ENV=development


# ── JWT ─────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_256bit_hex_string_never_commit_this


# ── Google OAuth 2.0 ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com


# ── Google Calendar (Service Account JSON key file path) ────
GOOGLE_CALENDAR_SA_KEY=./credentials/google-calendar-sa.json
