# ============================================================
#  Atur Perjalanan — Environment Variables Template
#  Copy this to .env (root) and backend/.env, then fill values.
#  NEVER commit the actual .env files.
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Connection pooler endpoint (PgBouncer port 6543) — used by NestJS at runtime
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10

# Direct connection (port 5432) — used only by `prisma migrate`
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── App Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-random-256-bit-secret

# ── Google ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Google Maps Platform API key — Places/Static Maps for activity thumbnails (M6)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Path to Google service account JSON — used for Calendar API (M16)
GOOGLE_CALENDAR_SA_KEY=./credentials/google-calendar-sa.json

# ── Cloudflare R2 ────────────────────────────────────────────
# Wajib — dipakai R2Service untuk presign upload (PUT) & download (GET)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-api-token-access-key
R2_SECRET_ACCESS_KEY=your-r2-api-token-secret
R2_BUCKET_NAME=atur-perjalanan-media

# Opsional — referensi internal saat menyimpan storage_url di DB.
# Client TIDAK memakai URL ini; akses media ke frontend via presigned GET
# (expires 1 jam) yang di-generate backend pada Register/List Documents,
# trip cover, chat media, dll. Lihat docs/ARCHITECTURE.md §7.
R2_PUBLIC_URL=https://your-r2-custom-domain.example.com

# ── Server ───────────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── Mobile (Expo) ────────────────────────────────────────────
# These are prefixed EXPO_PUBLIC_ so Metro inlines them at build time.
# Google OAuth 2.0 client IDs — required for sign-in flow
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Backend API URL — used by apiClient for all REST calls
EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# Supabase anon key & URL — used by realtime/supabaseClient (Realtime subscriptions only)
EXPO_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
