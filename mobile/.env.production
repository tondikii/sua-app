# ── Mobile (Expo) — PRODUCTION ENV ──────────────────────────────────
# Digunakan saat build web (Cloudflare Pages) & EAS production (Play Store).
# Expo meng-inline variabel EXPO_PUBLIC_* saat build time.
# Salin nilai asli dari .env dev, lalu ganti yang production-only.

# Google OAuth 2.0 client IDs — required for sign-in flow
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=463752801012-d0f7hsgg7f23ft4bacgeki81o5rnr2vf.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=463752801012-glj7j2ng20md0s52bp1luc3neen1jvdd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Web origin — harus match Authorized redirect URI di Google Cloud Console
EXPO_PUBLIC_WEB_ORIGIN=https://atur-perjalanan.pages.dev

# Backend API URL — Vercel production (isi setelah deploy)
EXPO_PUBLIC_API_URL=https://atur-perjalanan-backend.vercel.app/v1

# Supabase anon key & URL — Realtime subscriptions (sama dengan dev)
EXPO_PUBLIC_SUPABASE_URL=https://vclvoovqneuiorpiidqz.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZjbHZvb3ZxbmV1aW9ycGlpZHF6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM4NTgzOTAsImV4cCI6MjA5OTQzNDM5MH0.bb8x5jDq6RPYSgL-pkT5QmPnslzAPDILCg6jvNmbJ1U
