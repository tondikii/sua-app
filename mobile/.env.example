# Expo public env — exposed to the client bundle (EXPO_PUBLIC_*).
# Copy to `mobile/.env` and fill in. Never put secrets here; these ship to the app.

# NestJS API base URL (global prefix is /v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# Supabase — used ONLY for Realtime subscriptions (anon key is public-safe)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In (expo-auth-session). Native uses the iOS/Android client id;
# web uses a separate web client id with the app origin registered as an
# authorized redirect URI. Real OAuth wiring lands in M12.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-ios-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Web dev origin (OAuth redirect target on web)
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:8086
